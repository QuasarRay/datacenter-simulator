name: {{ dc.name }}

mgmt:
  network: {{ dc.mgmt.network }}
  ipv4-subnet: {{ dc.mgmt.subnet }}

topology:
  nodes:
{% for name, node in dc.nodes.items() %}
{% set profile = dc.profiles[node.role] %}
    {{ name }}:
      kind: {{ profile.kind }}
      image: {{ profile.image }}
      mgmt-ipv4: {{ node.mgmt_ip }}
      cpu: {{ profile.cpu }}
      memory: {{ profile.memory }}
      labels:
        role: "{{ node.role }}"
        asn: "{{ node.asn }}"
        loopback: "{{ node.loopback }}"
      exec:
        - "ip address replace {{ node.loopback }} dev lo"
{% for link in dc.links %}
{% for endpoint in link.endpoints %}
{% if endpoint.node == name %}
        - "ip address replace {{ endpoint.address }} dev {{ endpoint.interface }}"
        - "ip link set {{ endpoint.interface }} up"
{% endif %}
{% endfor %}
{% endfor %}

{% endfor %}
  links:
{% for link in dc.links %}
    - endpoints:
{% for endpoint in link.endpoints %}
        - "{{ endpoint.node }}:{{ endpoint.interface }}"
{% endfor %}
{% endfor %}
